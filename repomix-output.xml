	if p.Page != 1 || p.Limit != 20 || p.Offset != 0 {
		t.Errorf("bad defaults: %+v", p)
	}

	p, err = ValidatePagination("3", "10")
	if err != nil {
		t.Fatal(err)
	}
	if p.Page != 3 || p.Limit != 10 || p.Offset != 20 {
		t.Errorf("bad page 3: %+v", p)
	}

