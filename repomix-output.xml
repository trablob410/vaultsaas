    fn test_list_tools_returns_eight() {
        let tool_list = tools::list_tools();
        assert_eq!(tool_list.len(), 8);
        let names: Vec<&str> = tool_list.iter().map(|t| t.name.as_str()).collect();
        assert!(names.contains(&"request_secret_access"));
