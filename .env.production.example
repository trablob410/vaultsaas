# === Valt Production Environment ===
# Copy to .env and fill in values

# --- Database ---
POSTGRES_USER=valt
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=valt

# --- MinIO (Object Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=valt-secrets

# --- Encryption ---
# Generate: openssl rand -base64 32
VAULT_MASTER_KEY=

# --- Domain (leave empty for IP-only) ---
DOMAIN=
ACME_EMAIL=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://103.142.137.232/api/v1/auth/google/callback
DASHBOARD_URL=http://103.142.137.232
BASE_URL=http://103.142.137.232

# --- Stripe Billing (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# --- Slack (optional) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=valtbot

# --- Zalo (optional) ---
ZALO_OA_TOKEN=
ZALO_OA_ID=

# --- SMTP Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@valt.dev

# --- Redis (optional - enables rate limiting) ---
REDIS_URL=
