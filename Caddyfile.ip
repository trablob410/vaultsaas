:80 {
    # API routes
    handle /api/* {
        reverse_proxy server:8080
    }

    # Webhook routes (public, no auth)
    handle /webhooks/* {
        reverse_proxy server:8080
    }

    # OAuth callbacks
    handle /oauth/* {
        reverse_proxy server:8080
    }

    # Everything else goes to dashboard
    handle {
        reverse_proxy dashboard:3000
    }
}
