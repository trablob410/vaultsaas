# ─── PostgreSQL ───
POSTGRES_USER=valt
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=valt

# ─── MinIO ───
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_BUCKET=valt-secrets

# ─── Server ───
PORT=8080
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
SERVER_KEK=change_me_32_byte_hex_encoded_key
VAULT_MASTER_KEY=change_me_generate_with_openssl_rand_base64_32

# ─── SMTP (Email Notifications) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@valt.dev

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
DASHBOARD_URL=http://localhost:3000

# ─── Dashboard ───
NEXT_PUBLIC_API_URL=http://localhost:8443
BACKEND_URL=http://localhost:8080

# ─── Production Only ───
# DOMAIN=valt.dev
# ACME_EMAIL=admin@valt.dev
